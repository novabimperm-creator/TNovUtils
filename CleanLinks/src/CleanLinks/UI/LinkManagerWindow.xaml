<Window x:Class="CleanLinks.UI.LinkManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Связи проекта"
        Width="1081"
        Height="640"
        MinWidth="900"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СВЯЗИ ПРОЕКТА"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="Cancel_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock x:Name="HintText"
                       Grid.Row="1"
                       Style="{StaticResource DialogHintStyle}"
                       Margin="0,0,0,10"/>

            <DataGrid x:Name="LinksGrid"
                      Grid.Row="2"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="False"
                      ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Связь"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        MinWidth="180"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status}"
                                        Width="120"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTemplateColumn Header="Оси и уровни" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding GridOptions}"
                                          SelectedItem="{Binding GridValue, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding GridEnabled}"
                                          ToolTip="{Binding GridToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Наборы" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding WorksetSummary}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,4"
                                        Margin="0"
                                        IsEnabled="{Binding WorksetsEnabled}"
                                        ToolTip="{Binding WorksetsToolTip}"
                                        Click="Worksets_Click"
                                        Tag="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Действие" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding ActionOptions}"
                                          SelectedItem="{Binding ActionValue, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding ActionEnabled}"
                                          ToolTip="{Binding ActionToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Полутон" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding ViewOptions}"
                                          SelectedItem="{Binding HalftoneValue, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding ViewEnabled}"
                                          ToolTip="{Binding HalftoneToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="В текущем виде" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                          ItemsSource="{Binding HideOptions}"
                                          SelectedItem="{Binding HideValue, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding ViewEnabled}"
                                          ToolTip="{Binding HideToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3"
                       Text="{Binding Summary}"
                       Style="{StaticResource DialogHintStyle}"
                       Margin="0,10,0,10"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Сбросить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Reset_Click"/>
                <Button Grid.Column="2"
                        Content="Отмена"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Grid.Column="4"
                        Content="Применить"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        IsDefault="True"
                        Click="Apply_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
