<Window x:Class="CleanLinks.UI.LinkProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обработка"
        Width="480"
        Height="220"
        MinWidth="400"
        MinHeight="200"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Margin="6,6,6,10">
                <TextBlock Text="ОБРАБОТКА"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="CaptionText"
                       Grid.Row="1"
                       Style="{StaticResource DialogMessageStyle}"
                       Text="Готовлюсь…"/>

            <TextBlock x:Name="DetailText"
                       Grid.Row="2"
                       Style="{StaticResource DialogHintStyle}"
                       Margin="0,4,0,10"/>

            <Grid Grid.Row="3" Height="28" Margin="0,0,0,10">
                <ProgressBar x:Name="Bar"
                             Style="{StaticResource DarkProgressBarStyle}"
                             Height="28"
                             Minimum="0"
                             Maximum="1"
                             Value="0"/>
                <TextBlock x:Name="CounterText"
                           Style="{StaticResource DarkProgressBarLabelStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <Button Grid.Row="4"
                    Content="Прервать"
                    Style="{StaticResource SecondaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Width="140"
                    Click="Cancel_Click"/>
        </Grid>
    </Border>
</Window>
