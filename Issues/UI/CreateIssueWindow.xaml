<Window x:Class="TNovUtils.Issues.UI.CreateIssueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый вопрос"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="НОВЫЙ ВОПРОС"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="Cancel_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Модель:"
                               Foreground="{StaticResource MutedBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ModelText"
                               Foreground="White"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <StackPanel x:Name="ProjectPanel"
                            Visibility="Collapsed"
                            Margin="0,0,0,10">
                    <TextBlock Text="Проект не определился по имени модели — выберите вручную:"
                               Foreground="#FF8888"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="ProjectCombo"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Margin="0"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <TextBlock Text="Содержание *"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <TextBox x:Name="DescriptionBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,0,12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="90"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Ответственные"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AssigneesText"
                               Text="не выбраны"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,10,0"/>
                    <Button x:Name="PickAssigneesBtn"
                            Grid.Column="1"
                            Content="Выбрать…"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            MinHeight="32"
                            Click="PickAssignees_Click"/>
                </Grid>

                <TextBlock Text="Элемент текущей модели"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <TextBlock x:Name="ElementText"
                           Text="не выбран"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Взять из выделения Revit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            MinHeight="32"
                            Margin="0,0,8,0"
                            Click="GrabSelection_Click"/>
                    <Button Content="Очистить"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            MinHeight="32"
                            Click="ClearElement_Click"/>
                </StackPanel>

                <TextBlock Text="Фото"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <Border Style="{StaticResource PanelFrameStyle}"
                        Height="80"
                        Margin="0,0,0,8">
                    <ListBox x:Name="PhotosBox"
                             Style="{StaticResource JournalListBoxStyle}"
                             Foreground="White"
                             BorderThickness="0"/>
                </Border>
                <Button Content="Добавить фото…"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        MinHeight="32"
                        HorizontalAlignment="Left"
                        Click="AddPhotos_Click"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText"
                           Grid.Column="0"
                           Foreground="#FF8888"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0"/>
                <Button Grid.Column="1"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        MinWidth="90"
                        Click="Cancel_Click"/>
                <Button Grid.Column="3"
                        x:Name="CreateBtn"
                        Content="Создать"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        MinWidth="120"
                        IsDefault="True"
                        Click="Create_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
