<Window x:Class="TNovUtils.Issues.UI.IssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TNovPRO · Вопросы"
        Height="680"
        Width="1180"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Локальные алиасы: сохраняем прежние ключи, палитра — тёмная тема -->
            <SolidColorBrush x:Key="Emerald" Color="#37C871"/>
            <SolidColorBrush x:Key="EmeraldDark" Color="#2A9D5A"/>
            <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Muted" Color="#8FB3A2"/>
            <SolidColorBrush x:Key="Line" Color="#2A4D38"/>
            <SolidColorBrush x:Key="Card" Color="#1E2E26"/>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RunButtonStyle}">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="CompactGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- Статус-пилюли (как было: карточка → accent при выборе) -->
            <Style x:Key="Pill" TargetType="RadioButton">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b"
                                    CornerRadius="16"
                                    Background="{StaticResource Card}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    Padding="12,5">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Emerald}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Emerald}"/>
                                    <Setter Property="Foreground" Value="#14201A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Emerald}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MinePill" TargetType="ToggleButton">
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b"
                                    CornerRadius="16"
                                    Background="{StaticResource Card}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    Padding="14,6">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Emerald}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Emerald}"/>
                                    <Setter Property="Foreground" Value="#14201A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Emerald}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Combo" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                <Setter Property="MinWidth" Value="140"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="IssuesListViewItem" TargetType="ListViewItem">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="2,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <GridViewRowPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A4D3A"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#243830"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource Emerald}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            Margin="0">
        <DockPanel Margin="16,12,16,12">

            <!-- Шапка -->
            <Grid DockPanel.Dock="Top"
                  Margin="0,0,0,12"
                  MouseDown="TitleBar_MouseDown"
                  Background="Transparent"
                  Cursor="Arrow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="34" Height="34" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 L22,7 L12,12 L2,7 Z" Fill="#37C871"/>
                            <Path Data="M2,12 L12,17 L22,12" Stroke="#37C871" StrokeThickness="2" StrokeLineJoin="Round"/>
                            <Path Data="M2,17 L12,22 L22,17" Stroke="#37C871" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Вопросы"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="SubTitle"
                                   Text="BIM-замечания и коллизии"
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="NetCheckButton"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Click="NetCheck_Click"
                            ToolTip="Проверить связь с TNovPRO"
                            Content="Проверка сети"/>
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Click="Logout_Click"
                            ToolTip="Выйти из профиля TNovPRO"
                            Content="Выход"/>
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0"
                            Click="Refresh_Click"
                            ToolTip="Обновить"
                            Content="⟳"
                            FontSize="15"/>
                    <Button x:Name="CreateButton"
                            Style="{StaticResource PrimaryButton}"
                            Click="Create_Click"
                            Content="+  Добавить"/>
                    <Button Content="–" Margin="10,0,0,0"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="Minimize_Click"
                            ToolTip="Свернуть"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Margin="4,0,10,0"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="Cancel_Click"
                            ToolTip="Закрыть"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- Панель фильтров -->
            <Border DockPanel.Dock="Top"
                    Margin="0,0,0,12"
                    Padding="0,0,0,12"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal">
                    <Border CornerRadius="8"
                            Background="{StaticResource Card}"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            Margin="0,0,12,6"
                            Width="240">
                        <Grid>
                            <TextBlock Text="🔍"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="White"
                                     CaretBrush="White"
                                     Padding="28,7,8,7"
                                     VerticalContentAlignment="Center"
                                     TextChanged="Search_Changed"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Поиск по содержанию…"
                                       Margin="28,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <RadioButton x:Name="PillAll"
                                     GroupName="st"
                                     Style="{StaticResource Pill}"
                                     Tag=""
                                     IsChecked="True"
                                     Checked="StatusPill_Checked"
                                     Content="Все"/>
                        <RadioButton GroupName="st"
                                     Style="{StaticResource Pill}"
                                     Tag="new"
                                     Checked="StatusPill_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,6,0"/>
                                <TextBlock Text="Новое"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="st"
                                     Style="{StaticResource Pill}"
                                     Tag="in_progress"
                                     Checked="StatusPill_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock Text="В работе"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="st"
                                     Style="{StaticResource Pill}"
                                     Tag="completed"
                                     Checked="StatusPill_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#37C871" Margin="0,0,6,0"/>
                                <TextBlock Text="Выполнено"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="st"
                                     Style="{StaticResource Pill}"
                                     Tag="closed"
                                     Checked="StatusPill_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#8FB3A2" Margin="0,0,6,0"/>
                                <TextBlock Text="Закрыто"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <ComboBox x:Name="ProjectCombo"
                              Style="{StaticResource Combo}"
                              SelectionChanged="ServerFilter_Changed"/>
                    <ComboBox x:Name="ModelCombo"
                              Style="{StaticResource Combo}"
                              SelectionChanged="ServerFilter_Changed"/>
                    <ComboBox x:Name="AuthorCombo"
                              Style="{StaticResource Combo}"
                              SelectionChanged="ClientFilter_Changed"/>
                    <ComboBox x:Name="AssigneeCombo"
                              Style="{StaticResource Combo}"
                              SelectionChanged="ClientFilter_Changed"/>
                    <ToggleButton x:Name="MineToggle"
                                  Content="Мои"
                                  Style="{StaticResource MinePill}"
                                  Click="ServerFilter_Changed"/>
                </WrapPanel>
            </Border>

            <!-- Низ: статус-строка -->
            <Border DockPanel.Dock="Bottom"
                    Background="Transparent"
                    Padding="2,6,0,0"
                    Margin="0,8,0,0">
                <TextBlock x:Name="StatusBar"
                           Text="Готово"
                           Foreground="{StaticResource Muted}"
                           FontSize="11"/>
            </Border>

            <!-- Контент: список + деталь -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0" x:Name="DetailColumn"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="10"
                        Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1">
                    <Grid>
                        <ListView x:Name="IssuesList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Foreground="White"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ItemContainerStyle="{StaticResource IssuesListViewItem}"
                                  SelectionChanged="IssuesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="→"
                                                        Width="30"
                                                        Padding="0"
                                                        Tag="{Binding Id}"
                                                        Style="{StaticResource CompactGhostButton}"
                                                        ToolTip="Перейти к элементу текущей модели"
                                                        Click="RowGo_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="№" Width="50" DisplayMemberBinding="{Binding Number}"/>
                                    <GridViewColumn Header="Содержание" Width="360" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Статус" Width="110" DisplayMemberBinding="{Binding StatusRu}"/>
                                    <!-- ФИО, а не id: см. Issues/Api/PeopleDirectory.cs -->
                                    <GridViewColumn Header="Автор" Width="140" DisplayMemberBinding="{Binding AuthorName}"/>
                                    <GridViewColumn Header="Ответственные" Width="150" DisplayMemberBinding="{Binding AssigneesText}"/>
                                    <GridViewColumn Header="Фото" Width="50" DisplayMemberBinding="{Binding PhotoCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <Viewbox Width="56" Height="56" Margin="0,0,0,10">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M12,2 L22,7 L12,12 L2,7 Z"
                                          Stroke="#4A6B5C"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"/>
                                    <Path Data="M2,12 L12,17 L22,12"
                                          Stroke="#4A6B5C"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"/>
                                    <Path Data="M2,17 L12,22 L22,17"
                                          Stroke="#4A6B5C"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Вопросов нет."
                                       Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              Background="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"/>

                <Border Grid.Column="2"
                        x:Name="DetailCard"
                        CornerRadius="10"
                        Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DetailHeader"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Ink}"/>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Style="{StaticResource CompactGhostButton}"
                                        Padding="8,2"
                                        Click="CloseDetail_Click"/>
                            </Grid>
                            <TextBlock x:Name="DetailMeta"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,2,0,10"
                                       FontSize="11"/>

                            <TextBlock Text="Содержание"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBox x:Name="DetailDescription"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Margin="0,2,0,10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="90"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ответственные"
                                           Style="{StaticResource PanelHeaderStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                                <Button Grid.Column="1"
                                        x:Name="EditAssigneesButton"
                                        Content="Изменить"
                                        Style="{StaticResource CompactGhostButton}"
                                        Padding="8,3"
                                        Click="EditAssignees_Click"/>
                            </Grid>
                            <TextBlock x:Name="DetailAssignees"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,10"
                                       Foreground="{StaticResource Ink}"/>

                            <TextBlock Text="Модели и элементы"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <ItemsControl x:Name="ModelsList" Margin="0,2,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <Button Content="Перейти"
                                                    Width="74"
                                                    Tag="{Binding ElementId}"
                                                    Style="{StaticResource CompactGhostButton}"
                                                    Click="GoToElement_Click"/>
                                            <TextBlock Text="{Binding SlotLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"
                                                       Foreground="White"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Фото"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <WrapPanel x:Name="PhotosPanel" Margin="0,2,0,10"/>

                            <Button x:Name="SaveButton"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Content="Сохранить содержание"
                                    Click="Save_Click"/>

                            <TextBlock Text="Сменить статус"
                                       Style="{StaticResource PanelHeaderStyle}"
                                       Margin="0,14,0,4"/>
                            <WrapPanel x:Name="StatusActions"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
