<Window x:Class="TNovUtils.TypeFilterWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovUtils"
        mc:Ignorable="d"
        Height="520"
        Width="430"
        MinHeight="400"
        MinWidth="400"
        KeyDown="VisibilityFilterWPF_KeyDown"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ТИПОФИЛЬТР"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="btn_Ok_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="tbSearch"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Height="36"
                         VerticalContentAlignment="Center"
                         ToolTip="Поиск по имени типа"
                         TextChanged="tbSearch_TextChanged"/>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Поиск типов..."/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=tbSearch}" Value=""/>
                                        <Condition Binding="{Binding IsFocused, ElementName=tbSearch}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,10"
                    Padding="8,6">
                <TreeView x:Name="categoryTreeView"
                          Style="{StaticResource DarkTreeViewStyle}"
                          ItemContainerStyle="{StaticResource DarkTreeViewItemStyle}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.Resources>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="RecognizesAccessKey" Value="False"/>
                        </Style>
                        <DataTemplate DataType="{x:Type local:TypeFilterElementTypeViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource TreeCheckToggleStyle}"/>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type local:TypeFilterCategoryViewModel}"
                                                  ItemsSource="{Binding ElementTypesView}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource TreeCheckToggleStyle}"
                                              Checked="CategoryCheckBox_Checked"
                                              Unchecked="CategoryCheckBox_Checked"/>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </Border>

            <UniformGrid Grid.Row="3"
                         Columns="3"
                         Margin="0,0,0,10">
                <Button x:Name="btn_Hide"
                        Content="Скрыть"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,6"
                        MinHeight="32"
                        Margin="0,0,4,0"
                        Click="btn_Hide_Click"/>
                <Button x:Name="btn_Isolate"
                        Content="Изолировать"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,6"
                        MinHeight="32"
                        Margin="2,0"
                        Click="btn_Isolate_Click"/>
                <Button x:Name="btn_Select"
                        Content="Выбрать"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="8,6"
                        MinHeight="32"
                        Margin="4,0,0,0"
                        Click="btn_Select_Click"/>
            </UniformGrid>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="textBox_FilterName"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Height="36"
                         VerticalContentAlignment="Center"
                         TextAlignment="Center"/>
                <Button Grid.Column="2"
                        x:Name="btn_CreateFilter"
                        Content="Скрыть фильтром"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        MinHeight="36"
                        MinWidth="140"
                        Click="btn_CreateFilter_Click"/>
            </Grid>

            <Button Grid.Row="5"
                    x:Name="btn_Ok"
                    Content="Уйти"
                    Style="{StaticResource RunButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0"
                    Click="btn_Ok_Click"/>
        </Grid>
    </Border>
</Window>
