<Window x:Class="TNovUtils.Checklist.UI.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Чек-лист"
        MinHeight="640" Height="800"
        MinWidth="1081" Width="1081"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None"
        SourceInitialized="Window_SourceInitialized"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChecklistNavButtonStyle" TargetType="Button" BasedOn="{StaticResource JournalNavButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectedBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="ContentRow" Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TitleColumn" Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TitlePanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="ЧЕК-ЛИСТ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SubTitle"
                                   Margin="14,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton"
                                Content="–"
                                Style="{StaticResource CloseButtonStyleMini}"
                                Margin="0,0,6,0"
                                Click="Minimize_Click"
                                ToolTip="Свернуть"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CollapseButton"
                                Content="^"
                                Style="{StaticResource CloseButtonStyleMini}"
                                Margin="0,0,6,0"
                                Click="CollapseButton_Click"
                                ToolTip="Свернуть в полоску"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseButton"
                                Content="✕"
                                Style="{StaticResource CloseButtonStyleMini}"
                                Click="CloseButton_Click"
                                ToolTip="Закрыть"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ContentHost" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelFrameStyle}"
                        Margin="0,0,8,0"
                        Padding="8">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChecklistNavButtonStyle}"
                                        Command="{Binding DataContext.SelectNavCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding StatusBrush}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding StatusVisibility}"/>
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource PanelFrameStyle}"
                        Padding="0">
                    <ContentControl Content="{Binding CurrentContent}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
