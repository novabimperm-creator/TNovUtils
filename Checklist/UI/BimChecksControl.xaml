<UserControl x:Class="TNovUtils.Checklist.UI.BimChecksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TNovUtils.Checklist.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:BimChecksViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="BIM-проверки"
                   Style="{StaticResource PanelHeaderStyle}"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Store.Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ChangeCardStyle}"
                                Padding="10,8"
                                Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Style="{StaticResource DarkCheckBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource JournalModuleStyle}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayDate}"
                                                   Style="{StaticResource JournalDateStyle}"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LastChangedBy}"
                                                   Style="{StaticResource JournalDateStyle}"
                                                   Margin="8,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="Комментарии"
                                        Command="{Binding DataContext.EditCommentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
