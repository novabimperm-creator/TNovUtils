<UserControl x:Class="TNovUtils.Checklist.UI.AutoCheckDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tnov="clr-namespace:TNovCommon;assembly=TNovCommon"
             xmlns:local="clr-namespace:TNovUtils.Checklist.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:AutoCheckDetailViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <tnov:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding HeaderTitle}"
                       Style="{StaticResource PanelHeaderStyle}"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Margin="0,0,0,8"/>
            <Button Content="Обновить проверку"
                    Command="{Binding RunCommand}"
                    Style="{StaticResource OutlinedSecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Padding="14,8"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ChangeCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10"
                         Fill="{Binding StatusBrush}"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ResultTitle}"
                               Style="{StaticResource JournalModuleStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayDate}"
                                   Style="{StaticResource JournalDateStyle}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding LastRunBy}"
                                   Style="{StaticResource JournalDateStyle}"
                                   Margin="8,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0">
            <Button Content="Выбрать элементы"
                    Command="{Binding SelectElemsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Visibility="{Binding ElemIds, Converter={StaticResource StringToVisibilityConverter}}"/>
            <Button Content="Открыть лог"
                    Command="{Binding OpenLogCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    Visibility="{Binding ElemIds, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
