<Window x:Class="TNovUtils.RequestsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TNovUtils"
        Title="Список заявок"
        Height="580"
        Width="1060"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GridComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="MinHeight" Value="28"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СПИСОК ЗАЯВОК"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Статус:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,5,6"/>
                <ComboBox Name="cmbStatusFilter"
                          Width="160"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Margin="0,0,15,6"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Принято"/>
                    <ComboBoxItem Content="В_работе"/>
                    <ComboBoxItem Content="На_согласовании"/>
                    <ComboBoxItem Content="Выполнено"/>
                    <ComboBoxItem Content="Закрыто"/>
                </ComboBox>
                <TextBlock Text="Поиск:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,5,6"/>
                <TextBox Name="txtSearch"
                         Width="220"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         Margin="0,0,15,6"
                         TextChanged="OnSearchTextChanged"/>
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Обновить"
                        Padding="10,6"
                        MinHeight="36"
                        Margin="0,0,0,6"
                        Click="Refresh_Click"/>
            </WrapPanel>

            <DataGrid Grid.Row="2"
                      Name="dgRequests"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowEditEnding="dgRequests_RowEditEnding"
                      LoadingRow="dgRequests_LoadingRow"
                      MouseDoubleClick="dgRequests_MouseDoubleClick"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="50"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Заявитель"
                                        Binding="{Binding Requester}"
                                        Width="90"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridComboBoxColumn x:Name="colAssignee"
                                            Header="Ответственный"
                                            Width="110"
                                            SelectedValueBinding="{Binding Assignee, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{x:Static local:ResponsibleList.List}"
                                            DisplayMemberPath="Key"
                                            SelectedValuePath="Key"
                                            EditingElementStyle="{StaticResource GridComboStyle}"/>
                    <DataGridTextColumn Header="Объект"
                                        Binding="{Binding ProjectDisplayName}"
                                        Width="130"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridComboBoxColumn x:Name="colStatus"
                                            Header="Статус"
                                            Width="110"
                                            SelectedItemBinding="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{x:Static local:RequestsListWindow.StatusList}"
                                            EditingElementStyle="{StaticResource GridComboStyle}"/>
                    <DataGridTextColumn Header="Описание"
                                        Binding="{Binding Description}"
                                        Width="180"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Срок"
                                        Binding="{Binding Deadline, StringFormat=dd.MM.yyyy HH:mm}"
                                        Width="110"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="3"
                    Name="btnClose"
                    Content="Закрыть"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
