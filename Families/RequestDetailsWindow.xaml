<Window x:Class="TNovUtils.RequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заявки"
        Height="520"
        Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PropLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,6"/>
            </Style>
            <Style x:Key="PropValueStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ДЕТАЛИ ЗАЯВКИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="ID:" Grid.Row="0" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbId" Grid.Row="0" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>

                <TextBlock Text="Дата создания:" Grid.Row="1" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbDate" Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>

                <TextBlock Text="Заявитель:" Grid.Row="2" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbRequester" Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>

                <TextBlock Text="Ответственный:" Grid.Row="3" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbAssignee" Grid.Row="3" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>

                <TextBlock Text="Объект:" Grid.Row="4" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbProject" Grid.Row="4" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>

                <TextBlock Text="Срок:" Grid.Row="5" Grid.Column="0" Style="{StaticResource PropLabelStyle}"/>
                <TextBlock Name="tbDeadline" Grid.Row="5" Grid.Column="1" Style="{StaticResource PropValueStyle}"/>
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Статус:"
                           Foreground="{StaticResource MutedBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>
                <TextBlock Name="tbStatus"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Описание"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <TextBox Name="tbDescription"
                         Style="{StaticResource DarkTextBoxStyle}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <TextBlock Text="Фото / образец"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <Border Style="{StaticResource PanelFrameStyle}"
                        MinHeight="120">
                    <Grid>
                        <Image Name="imgPhoto"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        <TextBlock Name="tbNoPhoto"
                                   Text="Фото отсутствует"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Button Grid.Row="5"
                    Content="Закрыть"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
