<Window x:Class="TNovUtils.FamilyRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявка на семейство"
        Height="560"
        Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="120"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ЗАЯВКА НА СЕМЕЙСТВО"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="btnCancel_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="tbNamePrefix"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="tbUserName"
                               Margin="5,0,0,0"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="tbRolePrefix"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="tbUserRole"
                               Margin="5,0,0,0"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ответственный:"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          Name="cmbResponsible"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Margin="0"
                          IsEditable="False"
                          SelectedIndex="0"
                          ToolTip="Выберите ответственного"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Объект:"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox Grid.Column="1"
                          Name="cmbProject"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Margin="0"
                          IsEditable="True"
                          ToolTip="Выберите проект из списка или введите вручную"/>
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock Text="Описание *"
                           Style="{StaticResource PanelHeaderStyle}"
                           Margin="0,0,0,6"/>
                <TextBox Name="txtDescription"
                         Style="{StaticResource DarkTextBoxStyle}"
                         MinHeight="60"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Желаемые сроки:"
                           Style="{StaticResource FieldLabelStyle}"/>
                <DatePicker Grid.Column="1"
                            Name="dpDeadline"
                            Width="130"
                            Margin="0,0,0,0"/>
                <TextBox Grid.Column="3"
                         Name="txtTime"
                         Text="15:30"
                         Width="70"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         ToolTip="Формат ЧЧ:ММ"/>
            </Grid>

            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <TextBlock Text="Фото / образец"
                           Style="{StaticResource PanelHeaderStyle}"/>
                <Border Style="{StaticResource PanelFrameStyle}"
                        Height="100"
                        Margin="0,0,0,8">
                    <Grid>
                        <Image Name="imgPreview"
                               Stretch="Uniform"
                               Visibility="Collapsed"/>
                        <TextBlock Name="tbPhotoHint"
                                   Text="Нажмите Ctrl+V для вставки изображения"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <Button Name="btnClearPhoto"
                        Content="Очистить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        MinWidth="90"
                        HorizontalAlignment="Left"
                        Click="btnClearPhoto_Click"/>
            </StackPanel>

            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Name="btnCancel"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="btnCancel_Click"/>
                <Button Grid.Column="2"
                        Name="btnOk"
                        Content="Отправить заявку"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        Click="btnOk_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
